#!/usr/bin/env bash
# Pre-commit hook: the fast subset of CI (.github/workflows/ci.yml).
# Install: git config core.hooksPath .githooks
#
# CI additionally runs the e2e suite (go test -tags=e2e ./e2e/...). That is left
# out here deliberately — it takes ~47s, which is too slow for every commit — so
# a green hook is not a promise that CI will be green.
set -euo pipefail

echo "==> Checking gofmt..."
unformatted=$(gofmt -l . 2>&1 || true)
if [ -n "$unformatted" ]; then
  echo "Files not formatted (run 'gofmt -w .'):"
  echo "$unformatted"
  exit 1
fi

echo "==> Running go vet..."
go vet ./...

# Build-tagged packages are invisible to `go vet ./...`, so a rename in a shared
# helper would otherwise only surface in CI. Both are keyless and offline.
echo "==> Vetting build-tagged packages..."
go vet -tags=integration ./integration/...
go vet -tags=eval ./evals/...
go vet -tags=e2e ./e2e/...

echo "==> Running unit tests..."
go test ./...

# The command-contract guard walks the cobra tree and fails on a runnable command
# with no contract record. The `_test-*` fixture commands are `//go:build e2e`, so
# the run above cannot see them and `-tags=e2e ./e2e/...` does not compile ./cmd
# tests: the guard is only fixture-aware here. Keyless, offline, ~1s.
echo "==> Running cmd tests with the fixture commands compiled..."
go test -tags=e2e ./cmd/...

echo "==> All checks passed."
